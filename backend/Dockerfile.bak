# syntax = docker/dockerfile:1.4

# Adjust BUILDARG for the Python version
ARG PYTHON_VERSION=3.12-slim
FROM python:${PYTHON_VERSION} AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        libpq-dev \
        && rm -rf /var/lib/apt/lists/*

# Install Node.js (for building the frontend)
RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        && rm -rf /var/lib/apt/lists/*

# Create a non-root user
USER root
RUN useradd --create-home --uid 1000 appuser
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-install-rar --no-cache-dir -r requirements.txt

# Copy the backend source code
COPY . .

# Change to the non-root user
USER appuser

# Collect static files (will be overridden in development if we mount the source)
# We'll collect static files in the entrypoint command instead.

# Expose the port the app runs on
EXPOSE 8000

# Default command (can be overridden)
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
