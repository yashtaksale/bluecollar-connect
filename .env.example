# ─────────────────────────────────────────────────────────────
#  BlueCollar Connect — environment template
#
#  Copy to `.env` in this directory and adjust:
#      cp .env.example .env
#
#  Docker Compose reads `.env` automatically. The Django backend also reads
#  `backend/.env` if you run it outside Docker.
#
#  `.env` is gitignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────


# ── Django ──────────────────────────────────────────────────

# True for local development only. With DEBUG=False the app refuses to start
# unless DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS are both set.
DJANGO_DEBUG=True

# Leave blank in development (a throwaway dev key is used).
# REQUIRED in production — generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# This key signs every JWT. If it leaks, anyone can mint a token for any user.
DJANGO_SECRET_KEY=

# Comma-separated hostnames the backend will serve. Blank + DEBUG=True allows
# any host (convenient for testing from a phone on your LAN).
# Production example: DJANGO_ALLOWED_HOSTS=api.bluecollar.example,bluecollar.example
DJANGO_ALLOWED_HOSTS=

# Comma-separated browser origins allowed to call the API cross-origin.
# Blank + DEBUG=True falls back to localhost:5173 plus 192.168.x.x:5173.
# Production example: DJANGO_CORS_ALLOWED_ORIGINS=https://bluecollar.example
DJANGO_CORS_ALLOWED_ORIGINS=

# Timezone used to interpret naive datetimes sent by the browser (the value of
# an <input type="datetime-local"> has no UTC offset). Everything is stored in
# UTC regardless.
DISPLAY_TIME_ZONE=Asia/Kolkata

# Redirect HTTP→HTTPS in production. Set to False only if a proxy already does.
DJANGO_SECURE_SSL_REDIRECT=True


# ── JWT lifetimes ───────────────────────────────────────────

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7


# ── PostgreSQL / PostGIS ────────────────────────────────────

POSTGRES_DB=bluecollar_connect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
# `db` inside Docker Compose; `localhost` when running the backend directly.
POSTGRES_HOST=db
POSTGRES_PORT=5432
